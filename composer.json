{
	"name": "fusio/contentcopy",
	"description": "Push a post, page or custom post type — with its media, terms and custom fields — from one WordPress site to another.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.4",
		"monolog/monolog": "^3.8",
		"psr/log": "^3.0"
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3.95",
		"pestphp/pest": "^5.3",
		"php-stubs/wordpress-stubs": "^6.7",
		"phpstan/phpstan": "^2.1",
		"szepeviktor/phpstan-wordpress": "^2.0"
	},
	"autoload": {
		"psr-4": {
			"ContentCopy\\": "src/"
		}
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true,
		"allow-plugins": {
			"pestphp/pest-plugin": true
		}
	},
	"scripts": {
		"analyse": "phpstan analyse --memory-limit=1G",
		"lint": "find src tests dev-stubs contentcopy.php -name '*.php' -print0 | xargs -0 -n1 php -l",
		"test": "pest",
		"cs-check": "PHP_CS_FIXER_IGNORE_ENV=1 php-cs-fixer fix --dry-run --diff",
		"cs-fix": "PHP_CS_FIXER_IGNORE_ENV=1 php-cs-fixer fix"
	}
}
